---
import Layout from '../../layouts/Layout.astro';
import CharactersDesktop from '../../components/characters/CharactersDesktop.astro';
import CharactersMobile from '../../components/characters/CharactersMobile.astro';
import { characterDisplayGroups } from '../../data/character-display';
---

<Layout
  title="キャラクター一覧 | VS GUIDE"
  description="Vampire Survivorsのキャラクター一覧。通常・隠し・DLCキャラクターの初期武器、固有能力・パッシブ効果、キャラクターごとの解放条件を紹介します。"
  currentPath="/characters/"
>
  <!-- PC画面 (md以上で自動表示) -->
  <div data-character-view="desktop" class="hidden md:block">
    <CharactersDesktop characterGroups={characterDisplayGroups} />
  </div>

  <!-- スマホ画面 (md未満で自動表示) -->
  <div data-character-view="mobile" class="block md:hidden">
    <CharactersMobile characterGroups={characterDisplayGroups} />
  </div>
</Layout>
