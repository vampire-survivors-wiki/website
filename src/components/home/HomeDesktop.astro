---
---

<div class="w-full">
  <!-- 共通化されたヒーローエリア (フロストガラス帯) -->
  <section class="w-full hero-glass-band pt-12 pb-8 mb-10">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-mono font-medium tracking-widest text-slate-500 uppercase block mb-2">
        ARCHIVE & VERIFICATION COMPENDIUM
      </span>
      <h1 class="text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-950 mb-3">
        Vampire Survivors 攻略
      </h1>
      <p class="text-sm text-slate-600 max-w-2xl leading-relaxed">
        ステージ攻略からキャラクター・武器の解説、金策まで。初心者向けの情報からやり込み向けの攻略まで幅広く紹介します。
      </p>
      <div class="flex items-center gap-6 mt-6 text-xs font-mono text-slate-500">
        <a href="#strategy" class="hover:text-slate-900 transition-colors">
          01 攻略 ↓
        </a>
        <a href="#gold" class="hover:text-slate-900 transition-colors">
          02 金策 ↓
        </a>
        <a href="#updates" class="hover:text-slate-900 transition-colors">
          03 アップデート ↓
        </a>
        <a href="#note" class="hover:text-slate-900 transition-colors">
          04 note ↓
        </a>
        <a href="#youtube" class="hover:text-slate-900 transition-colors">
          05 YouTube ↓
        </a>
      </div>
    </div>
  </section>

  <!-- メインコンテンツ -->
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <!-- Section 01: 攻略ディレクトリ -->
    <section id="strategy" class="mb-16">
      <div class="flex items-center justify-between mb-6 pb-2 border-b border-slate-200/50">
        <div class="flex items-baseline gap-3">
          <span class="text-xs font-mono text-slate-500">SECTION 01</span>
          <h2 class="text-xl font-bold tracking-tight text-slate-950">攻略 / STRATEGY DIRECTORY</h2>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- 01 Stages -->
        <div class="glass-panel rounded-2xl overflow-hidden flex flex-col">
          <div class="bg-slate-900 text-white p-4">
            <span class="text-xs font-mono font-semibold tracking-wider">01 STAGES</span>
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <h3 class="text-lg font-bold text-slate-950 mb-2">ステージ攻略</h3>
            <p class="text-xs text-slate-600 leading-relaxed flex-1">
              本編・DLC各ステージの特徴やギミック、隠し要素と攻略手順を紹介。
            </p>
            <div class="flex justify-end pt-4 mt-4 border-t border-slate-200/60 text-xs font-mono text-slate-500">
              <a
                href="#"
                aria-label="ステージ攻略を開く"
                class="group inline-flex hover:text-blue-700 transition-colors"
              >
                <span class="group-hover:translate-x-1 transition-transform">開く →</span>
              </a>
            </div>
          </div>
        </div>

        <!-- 02 Bosses -->
        <div class="glass-panel rounded-2xl overflow-hidden flex flex-col">
          <div class="bg-slate-900 text-white p-4">
            <span class="text-xs font-mono font-semibold tracking-wider">02 BOSSES</span>
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <h3 class="text-lg font-bold text-slate-950 mb-2">ボス攻略</h3>
            <p class="text-xs text-slate-600 leading-relaxed flex-1">
              ボスの出現条件や攻撃・ギミック、討伐に使った構成と攻略手順を紹介。
            </p>
            <div class="flex justify-end pt-4 mt-4 border-t border-slate-200/60 text-xs font-mono text-slate-500">
              <a
                href="#"
                aria-label="ボス攻略を開く"
                class="group inline-flex hover:text-blue-700 transition-colors"
              >
                <span class="group-hover:translate-x-1 transition-transform">開く →</span>
              </a>
            </div>
          </div>
        </div>

        <!-- 03 Characters -->
        <div class="glass-panel rounded-2xl overflow-hidden flex flex-col">
          <div class="bg-slate-900 text-white p-4">
            <span class="text-xs font-mono font-semibold tracking-wider">03 CHARACTERS</span>
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <h3 class="text-lg font-bold text-slate-950 mb-2">キャラクター</h3>
            <p class="text-xs text-slate-600 leading-relaxed flex-1">
              キャラクターごとの性能や初期武器、固有能力・パッシブ効果を解説。
            </p>
            <div class="flex justify-end pt-4 mt-4 border-t border-slate-200/60 text-xs font-mono text-slate-500">
              <a
                href="/characters/"
                aria-label="キャラクターを開く"
                class="group inline-flex font-semibold text-blue-600 hover:text-blue-700 transition-colors"
              >
                <span class="group-hover:translate-x-1 transition-transform">開く →</span>
              </a>
            </div>
          </div>
        </div>

        <!-- 04 Secrets -->
        <div class="glass-panel rounded-2xl overflow-hidden flex flex-col">
          <div class="bg-slate-900 text-white p-4">
            <span class="text-xs font-mono font-semibold tracking-wider">04 SECRETS</span>
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <h3 class="text-lg font-bold text-slate-950 mb-2">アンロック</h3>
            <p class="text-xs text-slate-600 leading-relaxed flex-1">
              キャラクター・武器・ステージなどの解放条件や達成手順を紹介。
            </p>
            <div class="flex justify-end pt-4 mt-4 border-t border-slate-200/60 text-xs font-mono text-slate-500">
              <a
                href="#"
                aria-label="アンロックを開く"
                class="group inline-flex hover:text-blue-700 transition-colors"
              >
                <span class="group-hover:translate-x-1 transition-transform">開く →</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 02: 金策アーカイブ -->
    <section id="gold" class="mb-16">
      <div class="flex items-center justify-between mb-6 pb-2 border-b border-slate-200/50">
        <div class="flex items-baseline gap-3">
          <span class="text-xs font-mono text-slate-500">SECTION 02</span>
          <h2 class="text-xl font-bold tracking-tight text-slate-950">
            金策 / GOLD FARMING ARCHIVE
          </h2>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="glass-panel p-8 rounded-2xl flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono text-slate-500 block mb-1">02.01</span>
            <h3 class="text-lg font-bold text-slate-950 mb-1">仕組み・解説</h3>
            <span class="text-[11px] font-mono text-slate-500 uppercase tracking-wider block mb-3">
              THEORY & MECHANICS
            </span>
            <p class="text-xs text-slate-600 leading-relaxed mb-6">
              ゴールドフィーバーや金貨袋、悪食の瞳など、主な金策方法とその仕組みを解説。キャラクター・武器・アルカナや設定による効率の違いも紹介します。
            </p>
          </div>
          <div class="flex justify-end pt-4 border-t border-slate-200/60 text-xs">
            <a href="#" class="font-semibold text-slate-900 hover:text-blue-700 transition-colors">
              金策の仕組みを読む →
            </a>
          </div>
        </div>

        <div class="glass-panel p-8 rounded-2xl flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono text-slate-500 block mb-1">02.02</span>
            <h3 class="text-lg font-bold text-slate-950 mb-1">金策構築</h3>
            <span class="text-[11px] font-mono text-slate-500 uppercase tracking-wider block mb-3">
              OPTIMIZED BUILDS
            </span>
            <p class="text-xs text-slate-600 leading-relaxed mb-6">
              サミーやビッグ・トラウザーを使った金策構築を紹介。黄金の卵0個から大量所持時までの周回手順や獲得効率を解説します。
            </p>
          </div>
          <div class="flex justify-end pt-4 border-t border-slate-200/60 text-xs">
            <a href="#" class="font-semibold text-slate-900 hover:text-blue-700 transition-colors">
              金策ビルドを見る →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Section: アップデートログ -->
    <section id="updates" class="mb-16">
      <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-200/50">
        <div class="flex items-baseline gap-3">
          <span class="text-xs font-mono text-slate-500">SECTION</span>
          <h2 class="text-lg font-bold tracking-tight text-slate-950">アップデート / PATCH LOGS</h2>
        </div>
      </div>
      <div class="glass-panel p-6 rounded-2xl flex items-center justify-between">
        <div>
          <h3 class="text-base font-bold text-slate-950 mb-1">
            パッチ履歴・DLC追加要素の検証アーカイブ
          </h3>
          <p class="text-xs text-slate-600">
            アップデートやDLCで追加されたキャラクター・武器・ステージなどを紹介。新要素の概要や各コンテンツの詳しい解説記事をまとめています。
          </p>
        </div>
        <a
          href="#"
          class="text-xs font-semibold px-4 py-2 rounded-lg bg-white/70 hover:bg-white border border-slate-200 shadow-xs transition-colors flex items-center gap-1"
        >
          一覧を見る →
        </a>
      </div>
    </section>

    <!-- Section: note コラム -->
    <section id="note" class="mb-16">
      <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-200/50">
        <div class="flex items-baseline gap-3">
          <span class="text-xs font-mono text-slate-500">SECTION</span>
          <h2 class="text-lg font-bold tracking-tight text-slate-950">note / ESSAY & EDITORIAL</h2>
        </div>
      </div>
      <div class="glass-panel p-6 rounded-2xl flex items-center justify-between">
        <div>
          <h3 class="text-base font-bold text-slate-950 mb-1">note 攻略・解説記事集</h3>
          <p class="text-xs text-slate-600">
            Vampire
            Survivorsの攻略方法やキャラクター・武器の性能、ゲームシステムの解説、アップデートやDLCの情報を掲載しています。
          </p>
        </div>
        <a
          href="https://note.com/neo_magical"
          target="_blank"
          class="text-xs font-semibold px-4 py-2 rounded-lg bg-white/70 hover:bg-white border border-slate-200 shadow-xs transition-colors flex items-center gap-1"
        >
          記事を読む
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M15 3h6v6" />
            <path d="M10 14 21 3" />
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
          </svg>
        </a>
      </div>
    </section>

    <!-- Section: YouTube ライブラリ -->
    <section id="youtube" class="mb-16">
      <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-200/50">
        <div class="flex items-baseline gap-3">
          <span class="text-xs font-mono text-slate-500">SECTION</span>
          <h2 class="text-lg font-bold tracking-tight text-slate-950">YouTube / VIDEO LIBRARY</h2>
        </div>
      </div>
      <div class="glass-panel p-6 rounded-2xl flex items-center justify-between">
        <div>
          <h3 class="text-base font-bold text-slate-950 mb-1">YouTube 攻略動画</h3>
          <p class="text-xs text-slate-600">
            キャラクターの立ち回りや攻略手順、金策の様子などを実際のプレイ動画で紹介します。
          </p>
        </div>
        <a
          href="https://www.youtube.com/@hirakouki_vs"
          target="_blank"
          class="text-xs font-semibold px-4 py-2 rounded-lg bg-white/70 hover:bg-white border border-slate-200 shadow-xs transition-colors flex items-center gap-1"
        >
          チャンネルを見る
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M15 3h6v6" />
            <path d="M10 14 21 3" />
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
          </svg>
        </a>
      </div>
    </section>
  </div>
</div>
