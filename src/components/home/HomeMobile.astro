---
---

<div class="px-4 py-6 space-y-6">
  <!-- スマホ版純化ヒーローエリア -->
  <div class="space-y-1">
    <h1 class="text-2xl font-extrabold tracking-tight text-slate-950">Vampire Survivors 攻略</h1>
  </div>

  <!-- 01 攻略メインインデックス (2×2グリッド) -->
  <div class="space-y-3">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="w-1.5 h-3.5 bg-slate-950 rounded-xs"></span>
        <h2 class="text-xs font-bold text-slate-950">01 攻略メインインデックス</h2>
      </div>
      <span class="text-[10px] font-mono text-slate-400">4 CATEGORIES</span>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <!-- 01.01 Stages -->
      <a
        href="#strategy"
        class="glass-panel rounded-xl overflow-hidden flex flex-col justify-between group active:scale-98 transition-transform"
      >
                <div class="bg-slate-900 text-white px-2.5 py-1.5 text-[10px] font-mono">
          <span>MAPS 01.01</span>
        </div>
        <div class="bg-slate-900 text-white px-2.5 py-1.5 text-[10px] font-mono">
          <span>BOSSES 01.02</span>
        </div>
        <div class="bg-slate-900 text-white px-2.5 py-1.5 text-[10px] font-mono">
          <span>CHS 01.03</span>
        </div>
        <div class="bg-slate-900 text-white px-2.5 py-1.5 text-[10px] font-mono">
          <span>SECRETS 01.04</span>
        </div>
<div class="p-3">
          <h3 class="text-xs font-bold text-slate-950 mb-1 group-hover:text-blue-700">
            ステージ攻略
          </h3>
          <p class="text-[10px] text-slate-500 line-clamp-2 leading-relaxed">
            本編・DLC各ステージの侵攻順路
          </p>
        </div>
      </a>

      <!-- 01.02 Bosses -->
      <a
        href="#strategy"
        class="glass-panel rounded-xl overflow-hidden flex flex-col justify-between group active:scale-98 transition-transform"
      >
        <div class="p-3">
          <h3 class="text-xs font-bold text-slate-950 mb-1 group-hover:text-blue-700">ボス攻略</h3>
          <p class="text-[10px] text-slate-500 line-clamp-2 leading-relaxed">
            死神討伐ロジックと必要DPS
          </p>
        </div>
      </a>

      <!-- 01.03 Characters -->
      <a
        href="/characters/"
        class="glass-panel rounded-xl overflow-hidden flex flex-col justify-between group active:scale-98 transition-transform"
      >
        <div class="p-3">
          <h3 class="text-xs font-bold text-slate-950 mb-1 group-hover:text-blue-700">
            キャラクター
          </h3>
          <p class="text-[10px] text-slate-500 line-clamp-2 leading-relaxed">
            全生存者の性能・初期武器一覧
          </p>
        </div>
      </a>

      <!-- 01.04 Secrets -->
      <a
        href="#strategy"
        class="glass-panel rounded-xl overflow-hidden flex flex-col justify-between group active:scale-98 transition-transform"
      >
        <div class="p-3">
          <h3 class="text-xs font-bold text-slate-950 mb-1 group-hover:text-blue-700">
            アンロック
          </h3>
          <p class="text-[10px] text-slate-500 line-clamp-2 leading-relaxed">
            アチーブメント達成フラグ網羅
          </p>
        </div>
      </a>
    </div>
  </div>

  <!-- 02 金策アーカイブ / GOLD -->
  <div class="glass-panel rounded-2xl p-4 shadow-xs">
    <div class="flex items-center justify-between pb-3 mb-2 border-b border-slate-200/60">
      <div class="flex items-center gap-2">
        <span class="w-1.5 h-3.5 bg-slate-950 rounded-xs"></span>
        <h3 class="text-xs font-bold text-slate-950">02 金策アーカイブ / GOLD</h3>
      </div>
      <div class="text-[9px] font-mono text-slate-500 border border-slate-200/80 px-2 py-0.5 rounded-sm bg-white/40">
        HIGH EFFICIENCY
      </div>
    </div>

    <div class="divide-y divide-slate-100/80">
      <a href="#gold" class="py-2.5 flex items-start justify-between group">
        <div class="flex items-start gap-2.5">
          <span class="text-[10px] font-mono text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded-sm border border-slate-200/60 mt-0.5">
            01
          </span>
          <div>
            <h4 class="text-xs font-bold text-slate-900 group-hover:text-blue-700 transition-colors">
              仕組み・倍率解説
            </h4>
            <p class="text-[10px] text-slate-500 mt-0.5">Greed・呪い・金卵仕様の基礎理論</p>
          </div>
        </div>
        <span class="text-slate-400 group-hover:translate-x-0.5 transition-transform text-xs">
          ›
        </span>
      </a>

      <a href="#gold" class="py-2.5 flex items-start justify-between group">
        <div class="flex items-start gap-2.5">
          <span class="text-[10px] font-mono text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded-sm border border-slate-200/60 mt-0.5">
            02
          </span>
          <div>
            <h4 class="text-xs font-bold text-slate-900 group-hover:text-blue-700 transition-colors">
              金策ビルド & 完全放置構成
            </h4>
            <p class="text-[10px] text-slate-500 mt-0.5">サミー / トラウザー 毎分億稼ぎ検証</p>
          </div>
        </div>
        <span class="text-slate-400 group-hover:translate-x-0.5 transition-transform text-xs">
          ›
        </span>
      </a>
    </div>
  </div>

  <!-- 03 アップデート・外部メディア連携 -->
  <div class="glass-panel rounded-2xl p-3.5 space-y-2">
    <a
      href="#updates"
      class="flex items-center justify-between p-2 rounded-xl hover:bg-white/50 transition-colors group"
    >
      <div class="flex items-center gap-3">
        <div class="w-7 h-7 rounded-lg bg-slate-100 border border-slate-200/60 flex items-center justify-center text-slate-600">
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
        </div>
        <div>
          <div class="text-xs font-bold text-slate-900">
            アップデートログ{' '}
            <span class="text-[10px] font-mono text-slate-400 font-normal">2026.08</span>
          </div>
          <div class="text-[10px] text-slate-500">パッチノート・バランス調整一覧</div>
        </div>
      </div>
      <span class="text-xs text-slate-400 group-hover:translate-x-0.5 transition-transform">→</span>
    </a>

    <a
      href="https://note.com/neo_magical"
      target="_blank"
      class="flex items-center justify-between p-2 rounded-xl hover:bg-white/50 transition-colors group"
    >
      <div class="flex items-center gap-3">
        <div class="w-7 h-7 rounded-lg bg-slate-100 border border-slate-200/60 flex items-center justify-center text-slate-600">
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" x2="8" y1="13" y2="13"></line>
            <line x1="16" x2="8" y1="17" y2="17"></line>
          </svg>
        </div>
        <div>
          <div class="text-xs font-bold text-slate-900">note 攻略記事集</div>
          <div class="text-[10px] text-slate-500">より深いビルド考察・仕様検証ノート</div>
        </div>
      </div>
      <span class="text-xs text-slate-400 group-hover:translate-x-0.5 transition-transform">↗</span>
    </a>

    <a
      href="https://www.youtube.com/@hirakouki_vs"
      target="_blank"
      class="flex items-center justify-between p-2 rounded-xl hover:bg-white/50 transition-colors group"
    >
      <div class="flex items-center gap-3">
        <div class="w-7 h-7 rounded-lg bg-slate-100 border border-slate-200/60 flex items-center justify-center text-slate-600">
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <rect height="16" rx="2.18" ry="2.18" width="20" x="2" y="4"></rect>
            <polygon points="10 8 16 12 10 16 10 8"></polygon>
          </svg>
        </div>
        <div>
          <div class="text-xs font-bold text-slate-900">YouTube 検証アーカイブ</div>
          <div class="text-[10px] text-slate-500">実際の動作・稼ぎ効率の動画レビュー</div>
        </div>
      </div>
      <span class="text-xs text-slate-400 group-hover:translate-x-0.5 transition-transform">↗</span>
    </a>
  </div>
</div>
