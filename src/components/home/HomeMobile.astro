---
---

<div class="px-4 py-6 space-y-6">
  <!-- スマホ版純化ヒーローエリア -->
  <div class="space-y-1">
    <h1 class="text-2xl font-extrabold tracking-tight text-slate-950">Vampire Survivors 攻略</h1>
  </div>

  <!-- 01 攻略メインインデックス (2×2グリッド) -->
  <div id="strategy-mobile" class="space-y-3">
    <div class="flex items-baseline gap-2">
      <span class="text-[10px] font-mono text-slate-500">SECTION 01</span>
      <h2 class="text-xs font-bold text-slate-950">攻略 / STRATEGY DIRECTORY</h2>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <!-- 01.01 Stages -->
      <a
        href="#strategy-mobile"
        class="glass-panel rounded-xl overflow-hidden flex flex-col group active:scale-98 transition-transform"
      >
        <div class="bg-slate-900 text-white px-2.5 py-1.5 text-[10px] font-mono">
          <span>01 STAGES</span>
        </div>
        <div class="p-3 flex flex-col flex-1">
          <h3 class="text-xs font-bold text-slate-950 mb-1 group-hover:text-blue-700">
            ステージ攻略
          </h3>
          <p class="text-[10px] text-slate-500 leading-relaxed flex-1">各ステージの特徴と攻略手順。</p>
          <div class="flex justify-end pt-2 mt-3 border-t border-slate-200/60 text-[10px] font-mono text-slate-500">
            <span class="group-hover:translate-x-1 transition-transform">開く →</span>
          </div>
        </div>
      </a>

      <!-- 01.02 Bosses -->
      <a
        href="#strategy"
        class="glass-panel rounded-xl overflow-hidden flex flex-col group active:scale-98 transition-transform"
      >
        <div class="bg-slate-900 text-white px-2.5 py-1.5 text-[10px] font-mono">
          <span>02 BOSSES</span>
        </div>
        <div class="p-3 flex flex-col flex-1">
          <h3 class="text-xs font-bold text-slate-950 mb-1 group-hover:text-blue-700">ボス攻略</h3>
          <p class="text-[10px] text-slate-500 leading-relaxed flex-1">ボスの特徴と討伐方法。</p>
          <div class="flex justify-end pt-2 mt-3 border-t border-slate-200/60 text-[10px] font-mono text-slate-500">
            <span class="group-hover:translate-x-1 transition-transform">開く →</span>
          </div>
        </div>
      </a>

      <!-- 01.03 Characters -->
      <a
        href="/characters/"
        class="glass-panel rounded-xl overflow-hidden flex flex-col group active:scale-98 transition-transform"
      >
        <div class="bg-slate-900 text-white px-2.5 py-1.5 text-[10px] font-mono">
          <span>03 CHARACTERS</span>
        </div>
        <div class="p-3 flex flex-col flex-1">
          <h3 class="text-xs font-bold text-slate-950 mb-1 group-hover:text-blue-700">
            キャラクター
          </h3>
          <p class="text-[10px] text-slate-500 leading-relaxed flex-1">初期武器や固有能力を紹介。</p>
          <div class="flex justify-end pt-2 mt-3 border-t border-slate-200/60 text-[10px] font-mono text-slate-500">
            <span class="group-hover:translate-x-1 transition-transform">開く →</span>
          </div>
        </div>
      </a>

      <!-- 01.04 Secrets -->
      <a
        href="#strategy"
        class="glass-panel rounded-xl overflow-hidden flex flex-col group active:scale-98 transition-transform"
      >
        <div class="bg-slate-900 text-white px-2.5 py-1.5 text-[10px] font-mono">
          <span>04 SECRETS</span>
        </div>
        <div class="p-3 flex flex-col flex-1">
          <h3 class="text-xs font-bold text-slate-950 mb-1 group-hover:text-blue-700">
            アンロック
          </h3>
          <p class="text-[10px] text-slate-500 leading-relaxed flex-1">キャラ・武器・ステージの解放条件。</p>
          <div class="flex justify-end pt-2 mt-3 border-t border-slate-200/60 text-[10px] font-mono text-slate-500">
            <span class="group-hover:translate-x-1 transition-transform">開く →</span>
          </div>
        </div>
      </a>
    </div>
  </div>

  <!-- 02 金策アーカイブ / GOLD -->
  <div id="gold-mobile" class="glass-panel rounded-2xl p-4 shadow-xs">
    <div class="flex items-baseline gap-2 pb-3 mb-2 border-b border-slate-200/60">
      <span class="text-[10px] font-mono text-slate-500">SECTION 02</span>
      <h3 class="text-xs font-bold text-slate-950">金策 / GOLD FARMING ARCHIVE</h3>
    </div>

    <div class="divide-y divide-slate-100/80">
      <a href="#gold-mobile" class="py-2.5 flex items-start justify-between group">
        <div class="flex items-start gap-2.5">
          <span class="text-[10px] font-mono text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded-sm border border-slate-200/60 mt-0.5">
            02.01
          </span>
          <div>
            <h4 class="text-xs font-bold text-slate-900 group-hover:text-blue-700 transition-colors">
              仕組み・解説
            </h4>
            <span class="text-[9px] font-mono text-slate-500 uppercase tracking-wider block mt-0.5 mb-1">
              THEORY & MECHANICS
            </span>
            <p class="text-[10px] text-slate-500 leading-relaxed">
              金策の種類・ゴールドフィーバー・効率の仕組み
            </p>
          </div>
        </div>
        <span class="text-slate-400 group-hover:translate-x-0.5 transition-transform text-xs">
          ›
        </span>
      </a>

      <a href="#gold" class="py-2.5 flex items-start justify-between group">
        <div class="flex items-start gap-2.5">
          <span class="text-[10px] font-mono text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded-sm border border-slate-200/60 mt-0.5">
            02.02
          </span>
          <div>
            <h4 class="text-xs font-bold text-slate-900 group-hover:text-blue-700 transition-colors">
              金策構築
            </h4>
            <p class="text-[10px] text-slate-500 leading-relaxed">
              サミー・トラウザーの構築と獲得効率
            </p>
          </div>
        </div>
        <span class="text-slate-400 group-hover:translate-x-0.5 transition-transform text-xs">
          ›
        </span>
      </a>
    </div>
  </div>

  <!-- 03 アップデート・外部メディア連携 -->
  <div id="updates-mobile" class="glass-panel rounded-2xl p-3.5 space-y-2">
    <a
      href="#updates-mobile"
      class="flex items-center justify-between p-2 rounded-xl hover:bg-white/50 transition-colors group"
    >
      <div class="flex items-center gap-3">
        <div class="w-7 h-7 rounded-lg bg-slate-100 border border-slate-200/60 flex items-center justify-center text-slate-600">
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
        </div>
        <div>
          <div class="text-xs font-bold text-slate-900">アップデート / PATCH LOGS</div>
          <div class="text-[10px] font-semibold text-slate-700">
            アップデート・DLCの検証アーカイブ
          </div>
          <p class="text-[10px] text-slate-500 leading-relaxed">アップデート・DLCの追加要素を紹介。</p>
        </div>
      </div>
      <span class="text-xs text-slate-400 group-hover:translate-x-0.5 transition-transform">→</span>
    </a>

    <a
      href="https://note.com/neo_magical"
      target="_blank"
      class="flex items-center justify-between p-2 rounded-xl hover:bg-white/50 transition-colors group"
    >
      <div class="flex items-center gap-3">
        <div class="w-7 h-7 rounded-lg bg-slate-100 border border-slate-200/60 flex items-center justify-center text-slate-600">
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" x2="8" y1="13" y2="13"></line>
            <line x1="16" x2="8" y1="17" y2="17"></line>
          </svg>
        </div>
        <div>
          <div class="text-xs font-bold text-slate-900">note 攻略・解説記事集</div>
          <div class="text-[10px] text-slate-500">攻略・キャラ・武器・システムの解説記事。</div>
        </div>
      </div>
      <svg
        class="w-3.5 h-3.5 text-slate-400"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M15 3h6v6" />
        <path d="M10 14 21 3" />
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
      </svg>
    </a>

    <a
      href="https://www.youtube.com/@hirakouki_vs"
      target="_blank"
      class="flex items-center justify-between p-2 rounded-xl hover:bg-white/50 transition-colors group"
    >
      <div class="flex items-center gap-3">
        <div class="w-7 h-7 rounded-lg bg-slate-100 border border-slate-200/60 flex items-center justify-center text-slate-600">
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <rect height="16" rx="2.18" ry="2.18" width="20" x="2" y="4"></rect>
            <polygon points="10 8 16 12 10 16 10 8"></polygon>
          </svg>
        </div>
        <div>
          <div class="text-xs font-bold text-slate-900">YouTube 攻略動画</div>
          <div class="text-[10px] text-slate-500">攻略手順や金策のプレイ動画を紹介。</div>
        </div>
      </div>
      <svg
        class="w-3.5 h-3.5 text-slate-400"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M15 3h6v6" />
        <path d="M10 14 21 3" />
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
      </svg>
    </a>
  </div>
</div>
