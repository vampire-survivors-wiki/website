---
import type { CharacterDisplayGroups } from '../../data/character-display';

interface Props {
  characterGroups: CharacterDisplayGroups;
}

const { characterGroups } = Astro.props;
const {
  standard: standardCharacters,
  unlockable: unlockableCharacters,
  dlc: dlcCharacters,
} = characterGroups;
---

<div class="px-4 py-6 space-y-6">
  <!-- スマホパンくず & タイトル -->
  <div class="space-y-1.5">
    <nav
      aria-label="パンくずリスト"
      class="flex items-center gap-1.5 text-[11px] font-medium text-slate-500"
    >
      <svg
        class="w-3.5 h-3.5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1-1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
        />
      </svg>
      <a href="/" class="hover:text-slate-900">
        ホーム
      </a>
      <span aria-hidden="true">/</span>
      <a href="/strategy/" class="hover:text-slate-900">
        攻略
      </a>
      <span aria-hidden="true">/</span>
      <span class="text-slate-900 font-bold" aria-current="page">
        キャラクター
      </span>
    </nav>
    <h1 class="text-2xl font-extrabold tracking-tight text-slate-950">キャラクター一覧</h1>
    <p class="text-xs text-slate-600 leading-relaxed">
      各キャラクターの初期武器や固有能力・パッシブ効果を紹介。効果の発動条件や具体的な挙動、キャラクターごとの解放条件も解説します。
    </p>
  </div>

  <!-- 01 初期・通常キャラクター (画像枠が主役・名前のみタイト表示) -->
  <div
    class="space-y-2.5 pt-2 border-t border-slate-200/50"
    data-posthog-listing-section="standard"
  >
    <div class="flex items-baseline gap-2">
      <span class="text-[10px] font-mono text-red-600 font-bold">SECTION 01</span>
      <h2 class="text-xs font-bold text-slate-950">初期・通常キャラクター</h2>
    </div>

    <div class="grid grid-cols-2 gap-3">
      {standardCharacters.map((char) => (
        <div class="glass-panel rounded-xl p-2.5 flex flex-col items-center text-center">
          <!-- 正方形画像枠 -->
          <div class="w-full aspect-square rounded-lg bg-white/70 border border-slate-200/60 flex items-center justify-center mb-1.5">
            {char.image ? (
              <img
                src={char.image}
                alt={`${char.name}のキャラクター画像`}
                class="w-full h-full object-contain"
                loading={char.id === '01' ? 'eager' : 'lazy'}
                fetchpriority={char.id === '01' ? 'high' : undefined}
                decoding="async"
              />
            ) : (
              <svg
                class="w-8 h-8 text-slate-600"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                viewBox="0 0 24 24"
              >
                <path d={char.icon}></path>
              </svg>
            )}
          </div>
          <!-- タイトなキャラクター名のみ -->
          <span class="text-[11px] font-bold text-slate-900 leading-tight truncate w-full">
            {char.name}
          </span>
        </div>
      ))}
    </div>
  </div>

  <!-- 02 隠しキャラクター -->
  <div
    class="space-y-2.5 pt-4 border-t border-slate-200/50"
    data-posthog-listing-section="unlockable"
  >
    <div class="flex items-baseline gap-2">
      <span class="text-[10px] font-mono text-red-600 font-bold">SECTION 02</span>
      <h2 class="text-xs font-bold text-slate-950">隠しキャラクター</h2>
    </div>

    <div class="grid grid-cols-2 gap-3">
      {unlockableCharacters.map((char) => (
        <div class="glass-panel rounded-xl p-2.5 flex flex-col items-center text-center">
          <div class="w-full aspect-square rounded-lg bg-white/70 border border-slate-200/60 flex items-center justify-center mb-1.5">
            {char.image ? (
              <img
                src={char.image}
                alt={`${char.name}のキャラクター画像`}
                class="w-full h-full object-contain"
                loading={char.id === '01' ? 'eager' : 'lazy'}
                fetchpriority={char.id === '01' ? 'high' : undefined}
                decoding="async"
              />
            ) : (
              <svg
                class="w-8 h-8 text-slate-600"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                viewBox="0 0 24 24"
              >
                <path d={char.icon}></path>
              </svg>
            )}
          </div>
          <span class="text-[11px] font-bold text-slate-900 leading-tight truncate w-full">
            {char.name}
          </span>
        </div>
      ))}
    </div>
  </div>

  <!-- 03 Foscariの潮流 -->
  <div class="space-y-2.5 pt-4 border-t border-slate-200/50" data-posthog-listing-section="dlc">
    <div class="flex items-baseline gap-2">
      <span class="text-[10px] font-mono text-red-600 font-bold">SECTION 03</span>
      <h2 class="text-xs font-bold text-slate-950">Foscariの潮流</h2>
    </div>

    <div class="grid grid-cols-2 gap-3">
      {dlcCharacters.map((char) => (
        <div class="glass-panel rounded-xl p-2.5 flex flex-col items-center text-center">
          <div class="w-full aspect-square rounded-lg bg-white/70 border border-slate-200/60 flex items-center justify-center mb-1.5">
            {char.image ? (
              <img
                src={char.image}
                alt={`${char.name}のキャラクター画像`}
                class="w-full h-full object-contain"
                loading={char.id === '01' ? 'eager' : 'lazy'}
                fetchpriority={char.id === '01' ? 'high' : undefined}
                decoding="async"
              />
            ) : (
              <svg
                class="w-8 h-8 text-slate-600"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                viewBox="0 0 24 24"
              >
                <path d={char.icon}></path>
              </svg>
            )}
          </div>
          <span class="text-[11px] font-bold text-slate-900 leading-tight truncate w-full">
            {char.name}
          </span>
        </div>
      ))}
    </div>
  </div>
</div>
