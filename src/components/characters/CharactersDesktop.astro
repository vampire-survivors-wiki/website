---
import type { CharacterItem } from '../../data/characters';

interface Props {
  characters: CharacterItem[];
}

const { characters } = Astro.props;
const standardCount = characters.filter((c) => c.category === 'standard').length;
const unlockableCount = characters.filter((c) => c.category === 'unlockable').length;
const dlcCount = characters.filter((c) => c.category === 'dlc').length;
---

<div class="w-full">
  <!-- ホームと共通化されたヒーローエリア (フロストガラス帯) -->
  <section class="w-full hero-glass-band pt-12 pb-8 mb-10">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-mono font-medium tracking-widest text-slate-500 uppercase block mb-2">
        SURVIVORS COMPENDIUM & DATABASE
      </span>
      <h1 class="text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-950 mb-3">
        キャラクター一覧
      </h1>
      <p class="text-sm text-slate-600 max-w-2xl leading-relaxed">
        各キャラクターの初期武器や固有能力・パッシブ効果を紹介。効果の発動条件や具体的な挙動、キャラクターごとの解放条件も解説します。
      </p>
    </div>
  </section>

  <!-- メインコンテンツ -->
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <!-- Category Filter Tabs -->
    <div class="flex items-center justify-between mb-8 pb-4 border-b border-slate-200/50">
      <div class="flex items-center gap-2" role="group" aria-label="キャラクターの表示分類">
        <button
          type="button"
          data-character-filter="all"
          data-filter-label="全キャラクター"
          aria-pressed="true"
          class="px-4 py-1.5 rounded-lg text-xs font-semibold bg-slate-950 text-white shadow-xs transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-950"
        >
          全キャラクター ({characters.length})
        </button>
        <button
          type="button"
          data-character-filter="standard"
          data-filter-label="通常キャラクター"
          aria-pressed="false"
          class="px-4 py-1.5 rounded-lg text-xs font-medium text-slate-600 hover:text-slate-950 hover:bg-white/60 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-950"
        >
          通常キャラクター ({standardCount})
        </button>
        <button
          type="button"
          data-character-filter="unlockable"
          data-filter-label="隠しキャラクター"
          aria-pressed="false"
          class="px-4 py-1.5 rounded-lg text-xs font-medium text-slate-600 hover:text-slate-950 hover:bg-white/60 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-950"
        >
          隠しキャラクター ({unlockableCount})
        </button>
        <button
          type="button"
          data-character-filter="dlc"
          data-filter-label="Foscariの潮流"
          aria-pressed="false"
          class="px-4 py-1.5 rounded-lg text-xs font-medium text-slate-600 hover:text-slate-950 hover:bg-white/60 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-950"
        >
          Foscariの潮流 ({dlcCount})
        </button>
      </div>
    </div>

    <!-- Section 01: Standard Survivors -->
    <div class="mb-14" data-character-section="standard">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-baseline gap-2">
          <span class="text-xs font-mono text-red-600 font-bold">SECTION 01</span>
          <span class="text-slate-300 font-light">/</span>
          <h2 class="text-base font-bold text-slate-950">初期・通常キャラクター</h2>
          <span class="text-xs font-mono text-slate-500 uppercase">STANDARD SURVIVORS</span>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
        {characters
          .filter((c) => c.category === 'standard')
          .map((char) => (
            <div class="glass-panel rounded-xl p-3 flex flex-col justify-between group hover:shadow-md transition-all">
              <div class="flex items-center justify-between text-[10px] font-mono text-slate-400 mb-2">
                <span>#{char.id}</span>
                <span class="uppercase">ST</span>
              </div>
              <!-- Image Frame -->
              <div class="w-full aspect-square rounded-lg bg-white/70 border border-slate-200/50 flex items-center justify-center mb-3 group-hover:scale-102 transition-transform">
                <svg
                  class="w-8 h-8 text-slate-600"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  viewBox="0 0 24 24"
                >
                  <path d={char.icon}></path>
                </svg>
              </div>
              <div>
                <h3 class="text-xs font-bold text-slate-950 truncate mb-0.5">{char.name}</h3>
                <p class="text-[10px] text-slate-400 truncate font-mono mb-2">{char.nameEn}</p>
                <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[10px]">
                  <span class="text-slate-400">初期武器</span>
                  <span class="font-bold text-blue-700">{char.initialWeapon}</span>
                </div>
              </div>
            </div>
          ))}
      </div>
    </div>

    <!-- Section 02: Unlockable Survivors -->
    <div class="mb-14" data-character-section="unlockable">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-baseline gap-2">
          <span class="text-xs font-mono text-red-600 font-bold">SECTION 02</span>
          <span class="text-slate-300 font-light">/</span>
          <h2 class="text-base font-bold text-slate-950">隠しキャラクター</h2>
          <span class="text-xs font-mono text-slate-500 uppercase">HIDDEN SURVIVORS</span>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
        {characters
          .filter((c) => c.category === 'unlockable')
          .map((char) => (
            <div class="glass-panel rounded-xl p-3 flex flex-col justify-between group hover:shadow-md transition-all">
              <div class="flex items-center justify-between text-[10px] font-mono text-slate-400 mb-2">
                <span>#{char.id}</span>
                <span class="uppercase">SECRE</span>
              </div>
              <div class="w-full aspect-square rounded-lg bg-white/70 border border-slate-200/50 flex items-center justify-center mb-3 group-hover:scale-102 transition-transform">
                <svg
                  class="w-8 h-8 text-slate-600"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  viewBox="0 0 24 24"
                >
                  <path d={char.icon}></path>
                </svg>
              </div>
              <div>
                <h3 class="text-xs font-bold text-slate-950 truncate mb-0.5">{char.name}</h3>
                <p class="text-[10px] text-slate-400 truncate font-mono mb-2">{char.nameEn}</p>
                <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[10px]">
                  <span class="text-slate-400">初期武器</span>
                  <span class="font-bold text-blue-700">{char.initialWeapon}</span>
                </div>
              </div>
            </div>
          ))}
      </div>
    </div>

    <!-- Section 03: DLC Survivors -->
    <div class="mb-14" data-character-section="dlc">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-baseline gap-2">
          <span class="text-xs font-mono text-red-600 font-bold">SECTION 03</span>
          <span class="text-slate-300 font-light">/</span>
          <h2 class="text-base font-bold text-slate-950">Foscariの潮流</h2>
          <span class="text-xs font-mono text-slate-500 uppercase">TIDES OF THE FOSCARI</span>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
        {characters
          .filter((c) => c.category === 'dlc')
          .map((char) => (
            <div class="glass-panel rounded-xl p-3 flex flex-col justify-between group hover:shadow-md transition-all">
              <div class="flex items-center justify-between text-[10px] font-mono text-slate-400 mb-2">
                <span>#{char.id}</span>
                <span class="uppercase">DLC</span>
              </div>
              <div class="w-full aspect-square rounded-lg bg-white/70 border border-slate-200/50 flex items-center justify-center mb-3 group-hover:scale-102 transition-transform">
                <svg
                  class="w-8 h-8 text-slate-600"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  viewBox="0 0 24 24"
                >
                  <path d={char.icon}></path>
                </svg>
              </div>
              <div>
                <h3 class="text-xs font-bold text-slate-950 truncate mb-0.5">{char.name}</h3>
                <p class="text-[10px] text-slate-400 truncate font-mono mb-2">{char.nameEn}</p>
                <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[10px]">
                  <span class="text-slate-400">初期武器</span>
                  <span class="font-bold text-blue-700">{char.initialWeapon}</span>
                </div>
              </div>
            </div>
          ))}
      </div>
    </div>
  </div>
</div>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-character-filter]');
  const characterSections = document.querySelectorAll<HTMLElement>('[data-character-section]');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selectedFilter = button.dataset.characterFilter;
      if (!selectedFilter) return;

      filterButtons.forEach((filterButton) => {
        const isActive = filterButton === button;
        filterButton.setAttribute('aria-pressed', String(isActive));
        filterButton.classList.toggle('font-semibold', isActive);
        filterButton.classList.toggle('bg-slate-950', isActive);
        filterButton.classList.toggle('text-white', isActive);
        filterButton.classList.toggle('shadow-xs', isActive);
        filterButton.classList.toggle('font-medium', !isActive);
        filterButton.classList.toggle('text-slate-600', !isActive);
        filterButton.classList.toggle('hover:text-slate-950', !isActive);
        filterButton.classList.toggle('hover:bg-white/60', !isActive);
      });

      characterSections.forEach((section) => {
        const isVisible =
          selectedFilter === 'all' || section.dataset.characterSection === selectedFilter;
        section.hidden = !isVisible;
      });
    });
  });
</script>
