---
interface Props {
  currentPath: '/' | '/characters/';
}

const { currentPath } = Astro.props;
---

<!-- ドロワーオーバーレイ背景 -->
<div
  id="drawer-overlay"
  class="fixed inset-0 bg-slate-950/40 backdrop-blur-xs z-50 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
></div>

<!-- スライドインドロワー本体 -->
<aside
  id="drawer-panel"
  class="fixed top-0 right-0 bottom-0 w-[82vw] max-w-[340px] drawer-glass z-50 transform translate-x-full transition-transform duration-300 ease-out flex flex-col justify-between p-6 md:hidden"
>
  <div>
    <!-- ドロワーヘッダー -->
    <div class="flex items-center justify-between pb-5 border-b border-slate-200/60 mb-6">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-slate-950"></span>
        <span class="text-xs font-mono font-bold tracking-widest text-slate-800 uppercase">
          MENU
        </span>
      </div>
      <button
        id="drawer-close-btn"
        aria-label="メニューを閉じる"
        class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-slate-500 hover:text-slate-950 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- ナビゲーションリスト -->
    <nav class="space-y-2">
      <div class="pt-1 pb-1">
        <span class="text-[10px] font-mono text-slate-400 tracking-wider block px-3 mb-1">
          サイト内メニュー
        </span>
      </div>

      <a
        href="/"
        class:list={[
          'flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-colors',
          currentPath === '/'
            ? 'bg-slate-950 text-white shadow-xs'
            : 'text-slate-700 hover:bg-slate-100',
        ]}
      >
        <span>ホーム</span>
      </a>

      <a
        href="/#strategy-mobile"
        class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-medium text-slate-700 hover:bg-slate-100"
      >
        <span>攻略</span>
      </a>

      <a
        href="/#gold-mobile"
        class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-medium text-slate-700 hover:bg-slate-100"
      >
        <span>金策</span>
      </a>

      <a
        href="/#updates-mobile"
        class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-medium text-slate-700 hover:bg-slate-100"
      >
        <span>アップデート</span>
      </a>

      <div class="pt-3 pb-1">
        <span class="text-[10px] font-mono text-slate-400 tracking-wider block px-3 mb-1">
          外部リンク
        </span>
      </div>

      <a
        href="https://note.com/neo_magical"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between px-3.5 py-2 rounded-xl text-xs font-medium text-slate-600 hover:bg-slate-100"
      >
        <span>note 攻略・解説記事</span>
        <svg
          class="w-3.5 h-3.5 text-slate-400"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M15 3h6v6" />
          <path d="M10 14 21 3" />
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
        </svg>
      </a>

      <a
        href="https://www.youtube.com/@hirakouki_vs"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between px-3.5 py-2 rounded-xl text-xs font-medium text-slate-600 hover:bg-slate-100"
      >
        <span>YouTube 攻略動画</span>
        <svg
          class="w-3.5 h-3.5 text-slate-400"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M15 3h6v6" />
          <path d="M10 14 21 3" />
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
        </svg>
      </a>
    </nav>
  </div>

  <!-- ドロワーフッター -->
  <div class="pt-6 border-t border-slate-200/60 text-center">
    <div class="text-[10px] font-mono font-bold tracking-widest text-slate-500">VS GUIDE</div>
  </div>
</aside>

<script>
  const btn = document.getElementById('hamburger-btn');
  const closeBtn = document.getElementById('drawer-close-btn');
  const overlay = document.getElementById('drawer-overlay');
  const panel = document.getElementById('drawer-panel');

  function openDrawer() {
    overlay?.classList.remove('opacity-0', 'pointer-events-none');
    overlay?.classList.add('opacity-100');
    panel?.classList.remove('translate-x-full');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    overlay?.classList.add('opacity-0', 'pointer-events-none');
    overlay?.classList.remove('opacity-100');
    panel?.classList.add('translate-x-full');
    document.body.style.overflow = '';
  }

  btn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);
</script>
